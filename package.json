{
  "name": "agent-state",
  "version": "0.4.0",
  "description": "Local-first memory, recovery and control layer for AI coding agents (Claude Code, Cursor, Gemini CLI, Codex). Lose your session, recover the working context in seconds.",
  "type": "module",
  "bin": {
    "agent-state": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --test-concurrency=4 \"build-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "agents",
    "ai",
    "checkpoint",
    "claude-code",
    "cli",
    "codex",
    "context",
    "cursor",
    "developer-tools",
    "gemini-cli",
    "llm",
    "memory",
    "recovery"
  ],
  "author": "Alejovar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejovar/agent-state.git"
  },
  "bugs": {
    "url": "https://github.com/Alejovar/agent-state/issues"
  },
  "homepage": "https://github.com/Alejovar/agent-state#readme",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
